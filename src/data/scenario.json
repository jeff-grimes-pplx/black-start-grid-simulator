 "assumptions": [
  {
   "what": "Load level",
   "value": "59 % of the RTS annual peak (1681.5 MW, 342.2 Mvar), held constant",
   "source": "RTS load model: week 51 = 100 % (Table 2), Tuesday = 100 % (Table 3), winter weekday 3-4 am = 59 % (Table 4)",
   "url": "https://labs.ece.uw.edu/pstca/rts/rts79/ieeerts79.txt"
  },
  {
   "what": "Nuclear units (18 Astor, 21 Attlee)",
   "value": "unavailable for the whole restoration",
   "source": "PNNL-32773 Table 2: nuclear start-up time 'several days'",
   "url": "https://www.pnnl.gov/main/publications/external/technical_reports/PNNL-32773.pdf"
  },
  {
   "what": "Black-start units",
   "value": "the six U50 hydro units at 22 Aubrey and the four U20 oil CTs at 1 Abel and 2 Adams",
   "source": "Game designation; the RTS does not name black-start units. Hydro and CTs are the usual black-start resources (PNNL-32773)",
   "url": "https://www.pnnl.gov/main/publications/external/technical_reports/PNNL-32773.pdf"
  },
  {
   "what": "Start times",
   "value": "hydro 10 min, CT 30 min, steam units the RTS-96 hot-start time (U12/U100 2 h, U76/U155 3 h, U197 4 h, U350 8 h), synchronous condenser 20 min",
   "source": "PNNL-32773 Table 2 for hydro ('as fast as 10 min') and simple-cycle GT (30 min hot); RTS-96 Table 10 hot start for steam; condenser is a game value",
   "url": "https://labs.ece.uw.edu/pstca/rts/pg_tcarts.htm"
  },
  {
   "what": "Plant synchronization",
   "value": "black-start units of one plant that were started within 10 s of each other come on line together when the first is ready, so a single machine never energizes the plant's closed network alone",
   "source": "Game simplification of a plant-level start sequence",
   "url": null
  },
  {
   "what": "Cranking power",
   "value": "7 % of rating for steam units, drawn at the plant bus from the start command until synchronization, ramped in over 5 min, at 0.85 power factor",
   "source": "DOE/PNNL: thermal units need 7-8 % of nameplate to start; ramp-in and power factor are game values (PJM M-36 asks for auxiliaries in discrete steps)",
   "url": "https://www.energy.gov/sites/prod/files/2019/05/f62/Hydro-Black-Start_May2019.pdf"
  },
  {
   "what": "Inertia",
   "value": "RTS-96 Table 15 H on unit MW size (note 4)",
   "source": "RTS-96 Table 15",
   "url": "https://labs.ece.uw.edu/pstca/rts/pg_tcarts.htm"
  },
  {
   "what": "Reactive limits",
   "value": "Qmax is a hard limit (standard power-flow convention). A plant at its under-excitation limit (Qmin) holds a fixed internal EMF behind a synchronous reactance of 1.8 pu on the unit MVA base (Table 15 bases; 200 MVA assumed for the condenser), so surplus line charging raises voltage instead of lowering it",
   "source": "Game model; Xd value is a typical round-rotor figure, the RTS gives only transient reactances",
   "url": "https://labs.ece.uw.edu/pstca/rts/pg_tcarts.htm"
  },
  {
   "what": "Governor",
   "value": "5 % droop, 0.036 Hz deadband, first-order turbine response (hydro 1.0 s, combustion turbine 0.6 s, steam 2.5 s), primary response capped at 30 % of rating and by headroom",
   "source": "Droop and deadband: NERC Primary Frequency Control guideline (Eastern Interconnection maxima). 30 % cap after Chavez, Baldick & Sharma (ICREPQ'12, IEEE RTS study). Time constants are game values chosen for a stable, well-damped response",
   "url": "https://www.nerc.com/globalassets/who-we-are/standing-committees/rstc/rs/primary_frequency_control_reliability_guideline_v_4.0_clean_v3---dr.pdf"
  },
  {
   "what": "Minimum generation",
   "value": "RTS Pmin applies once an island carries at least the sum of its units' minimums; below that the minimums scale with island load (units idle near no-load during the first pickups)",
   "source": "Game simplification",
   "url": null
  },
  {
   "what": "Secondary control",
   "value": "each island returns to 60 Hz by moving unit setpoints at the RTS-96 Table 10 ramp rate (hydro: 60 MW/min), shared by rating, 60 s time constant",
   "source": "Ramp rates RTS-96 Table 10; sharing rule and time constant are game values",
   "url": "https://labs.ece.uw.edu/pstca/rts/pg_tcarts.htm"
  },
  {
   "what": "Load model",
   "value": "constant power and power factor per bus, served in five feeder blocks of 5 / 10 / 20 / 30 / 35 %; frequency sensitivity 1 % per 1 %; cold-load pickup not modeled",
   "source": "Game simplification",
   "url": null
  },
  {
   "what": "Generator frequency protection",
   "value": "units trip when the island frequency leaves the PRC-024-3 Eastern Interconnection no-trip zone (instant at <=57.8 or >=61.8 Hz; time-limited below 59.5 / above 60.5 Hz)",
   "source": "NERC PRC-024-3 Attachment 1. The standard defines where units must not trip; the game assumes they do trip outside it",
   "url": "https://www.nerc.com/globalassets/standards/reliability-standards/prc/prc-024-3.pdf"
  },
  {
   "what": "Generator voltage protection",
   "value": "a plant's units trip when its bus leaves the PRC-024-3 voltage no-trip zone (>=1.10 pu for 1 s ... <0.90 pu for 3 s)",
   "source": "NERC PRC-024-3 Attachment 2 (voltage boundary data points)",
   "url": "https://www.nerc.com/globalassets/standards/reliability-standards/prc/prc-024-3.pdf"
  },
  {
   "what": "Restoration operating bands",
   "value": "frequency 59.75-61.0 Hz, at or below 59.5 Hz shed load; voltage 0.90-1.05 pu",
   "source": "PJM Manual 36 (System Restoration)",
   "url": "https://www.pjm.com/-/media/DotCom/documents/manuals/m36.pdf"
  },
  {
   "what": "Branch thermal limits",
   "value": "continuous / long-time emergency (24 h) / short-time emergency (15 min) ratings; above STE the branch trips after 60 s, between LTE and STE after 15 min",
   "source": "Ratings and their durations: RTS-96 Table 12. The 60 s trip delay is a game value",
   "url": "https://labs.ece.uw.edu/pstca/rts/pg_tcarts.htm"
  },
  {
   "what": "Synchronizing and loop closing",
   "value": "tie closure needs |delta f| <= 0.10 Hz and |delta V| <= 0.05 pu; loop closure needs a standing angle <= 20 degrees",
   "source": "Game values (PJM M-36 requires matched frequency and voltage but gives no numbers)",
   "url": "https://www.pjm.com/-/media/DotCom/documents/manuals/m36.pdf"
  },
  {
   "what": "Data differences between sources",
   "value": "branch 14-16 reactance is 0.0389 pu in MATPOWER/PYPOWER/pandapower/PGLib-OPF but 0.059 pu in the RTS-79/96 paper table and RTS-GMLC (the game uses the MATPOWER value, which is what the solver was validated on); the long-time emergency ratings of A1 (250 vs 193 MVA) and A19-A23 (625 vs 600 MVA) differ between MATPOWER rateB and RTS-96 Table 12 (the game uses Table 12)",
   "source": "MATPOWER case24_ieee_rts.m vs RTS-96 Table 12",
   "url": "https://raw.githubusercontent.com/MATPOWER/matpower/master/data/case24_ieee_rts.m"
  },
  {
   "what": "Starting condition",
   "value": "every unit tripped, every breaker and feeder open, the bus 6 reactor open",
